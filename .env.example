# Database
# Full PostgreSQL connection URL
DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db:5432/naijabox

# For production docker-compose (individual DB vars for the postgres service)
POSTGRES_DB=naijabox
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<STRONG_DB_PASSWORD>

# Authentication (Auth.js / NextAuth)
# Generate with: openssl rand -base64 32
AUTH_SECRET=<32-char-random-secret>
# Must match your domain in production
AUTH_URL=https://yourdomain.app/api/auth

# Admin credentials (used for first-run seed / create-owner script)
# CHANGE THIS immediately after first login in production!
ADMIN_EMAIL=owner@yourdomain.app
ADMIN_PASSWORD=<STRONG_INITIAL_ADMIN_PASSWORD>

# Public site URL (used for metadataBase, OG images, sitemaps)
SITE_URL=https://yourdomain.app

# Domain for Caddy auto-HTTPS (no protocol prefix)
SITE_DOMAIN=yourdomain.app

# Contact email shown on the /contact page
CONTACT_EMAIL=hello@yourdomain.app

# Analytics / Content settings
# Minimum number of responses before community stats are shown (anti-fabrication gate)
MIN_STATS_SAMPLE=30
# Default number of questions per session
DEFAULT_QUESTION_COUNT=15

# Monetization (disabled by default — ADR-017)
NEXT_PUBLIC_ADS_ENABLED=false
AD_PROVIDER=none
