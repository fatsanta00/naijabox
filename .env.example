# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/naijabox

# Authentication (Auth.js)
AUTH_SECRET=naijabox_super_secret_key_change_in_production_32chars
AUTH_URL=http://localhost:3000/api/auth

# Initial Admin Credentials (used during seed/first run)
ADMIN_EMAIL=owner@naijabox.app
ADMIN_PASSWORD=naijabox_admin_secret_123

# Public & App Config
SITE_URL=http://localhost:3000
MIN_STATS_SAMPLE=30
DEFAULT_QUESTION_COUNT=15

# Monetization & Ads (Disabled by default per ADR-017)
NEXT_PUBLIC_ADS_ENABLED=false
AD_PROVIDER=none
